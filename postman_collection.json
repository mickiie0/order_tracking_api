		{
			"name": "Scenario 4 - Top-Up Failure & Resolve",
			"description": "ทดสอบ Transient Error (Retry w/ Backoff) vs Permanent Error (Failed) และการ Resolve โดยลูกค้า",
			"item": [
				{
					"name": "Customer Fixes Game UID on FAILED Order (Seed 900006)",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-User-ID",
								"value": "{{userId}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"action\": \"RETRY\",\n    \"game_uid\": \"correct-uid-88888\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/orders/ORD-20260101-900006/resolve",
							"host": ["{{baseUrl}}"],
							"path": ["orders", "ORD-20260101-900006", "resolve"]
						}
					}
				},
				{
					"name": "Customer Requests Refund on DELAYED Order (Seed 900007)",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-User-ID",
								"value": "{{userId}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"action\": \"REFUND\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/orders/ORD-20260101-900007/resolve",
							"host": ["{{baseUrl}}"],
							"path": ["orders", "ORD-20260101-900007", "resolve"]
						}
					}
				},
				{
					"name": "Resolve Forbidden (Wrong User -> 403)",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-User-ID",
								"value": "hacker-user"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"action\": \"REFUND\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/orders/ORD-20260101-900006/resolve",
							"host": ["{{baseUrl}}"],
							"path": ["orders", "ORD-20260101-900006", "resolve"]
						}
					}
				},
				{
					"name": "Resolve Completed Order -> 409 ORDER_NOT_RESOLVABLE",
