		{
			"name": "Scenario 3 - Bank Webhooks (Idempotency & Out-of-order)",
			"description": "ทดสอบ Webhook Verification, Deduplication, สลับลำดับ, และ Late Webhook บน Expired Order",
			"item": [
				{
					"name": "Step 1: Sign Payment Webhook (Dev Helper)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('webhookSignature', jsonData.signature);",
									"    pm.collectionVariables.set('webhookBody', jsonData.body);",
									"    console.log('Generated Signature:', jsonData.signature);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"event_id\": \"evt-postman-{{$timestamp}}\",\n    \"order_no\": \"{{currentOrderNo}}\",\n    \"type\": \"payment.succeeded\",\n    \"amount\": 120\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/dev/webhooks/sign",
							"host": ["{{baseUrl}}"],
							"path": ["dev", "webhooks", "sign"]
						}
					}
				},
				{
					"name": "Step 2: Deliver Valid Payment Webhook -> QUEUED",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-Signature",
								"value": "{{webhookSignature}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{{webhookBody}}"
						},
						"url": {
							"raw": "{{baseUrl}}/webhooks/payment",
							"host": ["{{baseUrl}}"],
							"path": ["webhooks", "payment"]
						}
					}
				},
				{
					"name": "Step 3: Deliver Duplicate Webhook -> DUPLICATE_IGNORED",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-Signature",
								"value": "{{webhookSignature}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{{webhookBody}}"
						},
						"url": {
							"raw": "{{baseUrl}}/webhooks/payment",
							"host": ["{{baseUrl}}"],
							"path": ["webhooks", "payment"]
						}
					}
				},
				{
					"name": "Step 4: Invalid Signature -> 401 INVALID_SIGNATURE",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-Signature",
								"value": "deadbeef-forged-signature"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"event_id\": \"evt-fake\",\n    \"order_no\": \"{{currentOrderNo}}\",\n    \"type\": \"payment.succeeded\",\n    \"amount\": 120\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/webhooks/payment",
							"host": ["{{baseUrl}}"],
							"path": ["webhooks", "payment"]
						}
					}
				},
				{
					"name": "Step 5: Sign Late Webhook for Expired Order (Seed 900008)",
					"event": [
						{
							"listen": "test",
