						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201 || pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.order_no) {",
									"        pm.collectionVariables.set('currentOrderNo', jsonData.order_no);",
									"        console.log('Saved currentOrderNo:', jsonData.order_no);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Idempotency-Key",
								"value": "pm-key-{{$timestamp}}"
							}
						],
						"body": {
							"mode": "raw",
